  function togglePick(id) { picked.has(id) ? picked.delete(id) : picked.add(id); render(); }
  $("btnSelect").onclick = () => setSelecting(!selecting);
  $("selExit").onclick = () => setSelecting(false);
  $("selAll").onclick = () => { visibleIds.forEach(id => picked.add(id)); render(); };
  $("selDown").onclick = () => { S.devices.filter(d => d.status === "down").forEach(d => picked.add(d.id)); render(); };
  $("selNone").onclick = () => { picked.clear(); render(); };
  async function bulk(action, extra) {
    try {
      const j = await api("device/bulk", { ids: [...picked], action, ...(extra || {}) });
      toast("info", t("Đã cập nhật {0} thiết bị", j.changed));
    } catch (err) { toast("down", err.message); }
  }
  $("selPause").onclick = () => bulk("pause");
  $("selResume").onclick = () => bulk("resume");
  $("selGroup").onclick = () => {
    $("gHint").textContent = t("Chuyển {0} thiết bị đã chọn sang nhóm:", picked.size);
    $("gErr").textContent = ""; $("fGroupMove").reset(); open("mGroup");
  };
  $("fGroupMove").onsubmit = async e => {
    e.preventDefault();
    await bulk("group", { grp: e.target.grp.value });
    close(e.target);
  };
  $("selDelete").onclick = () => {
    const list = S.devices.filter(d => picked.has(d.id));
    const preview = list.slice(0, 8).map(d => "• " + esc(d.name) + " (" + esc(d.host) + ")").join("<br>") + (list.length > 8 ? "<br>" + t("… và {0} thiết bị khác", list.length - 8) : "");
    confirmBox(t("Xoá {0} thiết bị?", list.length), preview, list.length >= 10, async () => {
      const j = await api("device/delete", { ids: [...picked] });
      picked.clear(); toast("info", t("Đã xoá {0} thiết bị", j.deleted));
    });
  };
  $("btnDeleteAll").onclick = () => {
    $("mSettings").hidden = true;
    confirmBox(t("Xoá tất cả {0} thiết bị?", S.devices.length), t("Toàn bộ danh sách giám sát sẽ bị xoá. Không thể hoàn tác (nên bấm <b>Xuất CSV</b> để lưu lại trước)."), true, async () => {
      const j = await api("device/delete", { all: true });
      picked.clear(); toast("info", t("Đã xoá {0} thiết bị", j.deleted));
    });
  };

  // hop xac nhan (go XOA khi xoa nhieu)
  let confirmFn = null;
  function confirmBox(title, html, needWord, fn) {
    $("cTitle").textContent = title; $("cBody").innerHTML = html;
    $("cTypeWrap").hidden = !needWord; $("cErr").textContent = "";
    $("fConfirm").reset(); confirmFn = fn; open("mConfirm");
