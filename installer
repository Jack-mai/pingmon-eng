  const STATE_LABEL = { up: t("Hoạt động"), down: t("MẤT KẾT NỐI"), unknown: t("Đang kiểm tra…"), paused: t("Tạm dừng") };
  const titleOf = s => s.title === "Giám sát mạng nội bộ" ? t(s.title) : s.title;
  const ORDER = { down: 0, unknown: 1, up: 2, paused: 3 };
  const rttText = d => d.rtt == null ? "" : `${d.rtt < 10 ? d.rtt.toFixed(1) : Math.round(d.rtt)} ms`;

  function filtered() {
    const q = $("q").value.trim().toLowerCase(), g = $("fGroup").value;
    const list = S.devices.filter(d =>
      (!g || d.grp === g) &&
      (filter === "all" || (filter === "other" ? !["up", "down"].includes(d.status) : d.status === filter)) &&
      (!q || [d.name, d.host, d.note, d.target, d.grp].join(" ").toLowerCase().includes(q)));
    list.sort((a, b) => (ORDER[a.status] - ORDER[b.status]) || a.grp.localeCompare(b.grp, "vi") || a.name.localeCompare(b.name, "vi", { numeric: true }));
    return list;
  }

  function render() {
    if (!S) return;
    const now = nowS(), devs = S.devices;
    const cnt = { up: 0, down: 0, other: 0 };
    devs.forEach(d => { if (d.status === "up") cnt.up++; else if (d.status === "down") cnt.down++; else cnt.other++; });
    $("sTotal").textContent = devs.length; $("sUp").textContent = cnt.up;
    $("sDown").textContent = cnt.down; $("sOther").textContent = cnt.other;
    $("statDown").classList.toggle("has", cnt.down > 0);
    document.querySelectorAll(".stat").forEach(s => s.classList.toggle("sel", s.dataset.f === filter && filter !== "all"));
    $("logo").classList.toggle("bad", cnt.down > 0);
    $("title").textContent = titleOf(S.settings);
    document.title = (cnt.down ? "🔴 " + t("{0} mất kết nối – ", cnt.down) : "") + titleOf(S.settings);
    setFavicon(cnt.down > 0);

    const downs = devs.filter(d => d.status === "down").sort((a, b) => a.since - b.since);
    $("downbar").hidden = !downs.length;
    $("downbar").innerHTML = downs.length ? t("MẤT KẾT NỐI:") + downs.map(d =>
      `<span class="chip" data-id="${d.id}" data-hist="${d.id}">${esc(d.name)} · ${dur(now - d.since)}</span>`).join("") : "";

    const groups = [...new Set(devs.map(d => d.grp).filter(Boolean))].sort((a, b) => a.localeCompare(b, "vi"));
    const fg = $("fGroup"), cur = fg.value;
    const opts = `<option value="">${t("Tất cả nhóm")}</option>` + groups.map(g => `<option>${esc(g)}</option>`).join("");
    if (fg.dataset.o !== opts) { fg.innerHTML = opts; fg.value = cur; fg.dataset.o = opts; }
    $("groups").innerHTML = groups.map(g => `<option value="${esc(g)}">`).join("");

    // bo chon thiet bi da bi xoa
    const ids = new Set(devs.map(d => d.id));
    [...picked].forEach(id => { if (!ids.has(id)) picked.delete(id); });

    const list = filtered();
    visibleIds = list.map(d => d.id);
    const grid = $("grid");
    grid.classList.toggle("selecting", selecting);
    grid.innerHTML = !list.length ? emptyHtml(devs.length) : (ui.view === "list" ? listHtml(list, now) : tilesHtml(list, now, groups.length > 1 && !$("fGroup").value));

    document.body.classList.toggle("admin", S.admin);
    ["btnAdd", "btnImport", "btnExport", "btnSettings", "btnSelect"].forEach(id => $(id).hidden = !S.admin);
    $("btnLogin").hidden = S.admin || !S.auth;
    $("btnLogout").hidden = !S.auth;
    if (!S.admin && selecting) setSelecting(false);
    updSelbar();
  }
  function emptyHtml(total) {
    return `<div class="empty">${total ? t("Không có thiết bị nào khớp bộ lọc.") :
      (S.admin ? t("Chưa có thiết bị. Bấm <b>+ Thêm thiết bị</b> hoặc <b>Nhập danh sách</b>.") :
                 t("Chưa có thiết bị. Đăng nhập quản trị để thêm thiết bị."))}</div>`;
  }
  function tilesHtml(list, now, showGroups) {
    if (showGroups) {   // gom theo nhom: khoi "dang mat ket noi" len dau, sau do tung nhom
      list = list.slice().sort((a, b) => ((a.status === "down") ? 0 : 1) - ((b.status === "down") ? 0 : 1)
        || (a.status === "down" ? 0 : a.grp.localeCompare(b.grp, "vi"))
        || (ORDER[a.status] - ORDER[b.status]) || a.name.localeCompare(b.name, "vi", { numeric: true }));
    }
    let html = "", lastGroup = null;
    for (const d of list) {
      const key = d.status === "down" ? "\u0000down" : (d.grp || "");
      if (showGroups && key !== lastGroup) {
        const gIds = list.filter(x => (x.status === "down" ? "\u0000down" : (x.grp || "")) === key).map(x => x.id);
        html += `<div class="group-title">${key === "\u0000down" ? t("Đang mất kết nối") : esc(d.grp || t("Chưa phân nhóm"))}
          ${selecting ? `<button class="sm ghost" data-pickgroup="${gIds.join(",")}">${t("chọn cả nhóm ({0})", gIds.length)}</button>` : ""}</div>`;
        lastGroup = key;
      }
      const hist = d.hist.padStart(30, "e").slice(-30);
      const spark = [...hist].map(c => `<i class="${c === "1" ? "" : c === "0" ? "f" : "e"}"></i>`).join("");
      const cls = [d.status, flashUntil[d.id] > Date.now() ? "flash" : "", picked.has(d.id) ? "picked" : ""].join(" ");
      const right = d.status === "up" ? rttText(d) : d.status === "down" ? dur(now - d.since) : "";
      const sub = d.status === "up" ? t("ổn định {0}", dur(now - d.since)) + (d.loss ? t(" · mất {0}%", d.loss) : "") :
                  d.status === "down" ? t("từ {0}", fmtTime(d.since, false)) : "";
      html += `<div class="tile ${cls}" data-id="${d.id}">
        <div class="t-head">${selecting ? `<input type="checkbox" tabindex="-1" ${picked.has(d.id) ? "checked" : ""}>` : '<span class="dot"></span>'}
          <span class="t-name"><span data-hist="${d.id}">${esc(d.name)}</span></span><span class="badge">${TYPE_LABEL[d.type]}</span>${S.admin ? `<button class="t-edit" data-edit="${d.id}" title="${t("Sửa thiết bị")}">✎</button>` : ""}</div>
        <div class="t-host">${esc(devTarget(d))}${d.grp && !showGroups ? " · " + esc(d.grp) : ""}</div>
        <div class="t-row"><span class="t-state">${STATE_LABEL[d.status]}</span><span class="t-dur">${right}</span></div>
        <div class="t-row"><span class="t-dur">${sub}</span></div>
        <div class="spark">${spark}</div>
        ${d.status === "down" && d.msg ? `<div class="t-msg">${esc(trMsg(d.msg))}</div>` : ""}
      </div>`;
    }
    return html;
  }
  function listHtml(list, now) {
    const allPicked = list.length && list.every(d => picked.has(d.id));
    return `<div class="tablewrap"><table><thead><tr>
      ${selecting ? `<th style="width:30px"><input type="checkbox" data-pickall ${allPicked ? "checked" : ""}></th>` : ""}
      ${["Trạng thái", "Tên thiết bị", "Địa chỉ", "Nhóm", "Loại", "Độ trễ", "Thời gian", "Mất gói"].map(h => `<th>${t(h)}</th>`).join("")}
      ${S.admin && !selecting ? "<th></th>" : ""}</tr></thead><tbody>` +
      list.map(d => {
        const cls = [d.status, flashUntil[d.id] > Date.now() ? "flash" : "", picked.has(d.id) ? "picked" : ""].join(" ");
        const time = d.status === "up" || d.status === "down" ? dur(now - d.since) : "";
        return `<tr class="${cls}" data-id="${d.id}">
          ${selecting ? `<td><input type="checkbox" tabindex="-1" ${picked.has(d.id) ? "checked" : ""}></td>` : ""}
          <td class="st">${STATE_LABEL[d.status]}</td>
          <td class="nm"><span data-hist="${d.id}">${esc(d.name)}</span>${d.status === "down" && d.msg ? `<div class="err">${esc(trMsg(d.msg))}</div>` : ""}${d.note ? `<div class="err" style="color:var(--muted)">${esc(d.note)}</div>` : ""}</td>
          <td>${esc(devTarget(d))}</td><td>${esc(d.grp)}</td><td>${TYPE_LABEL[d.type]}</td>
          <td class="num">${d.status === "up" ? rttText(d) : ""}</td><td class="num">${time}</td>
          <td class="num">${d.loss != null && d.status !== "paused" ? d.loss + "%" : ""}</td>
          ${S.admin && !selecting ? `<td><button class="sm" data-edit="${d.id}">${t("Sửa")}</button></td>` : ""}
        </tr>`;
      }).join("") + "</tbody></table></div>";
  }

  function renderEvents() {
    const only = $("evOnlyState").checked;
    const list = events.filter(e => !only || e.kind === "down" || e.kind === "up").slice(-150).reverse();
    const devIds = new Set(S ? S.devices.map(d => d.id) : []);
    $("events").innerHTML = list.map(e => {
      const k = e.kind === "down" || e.kind === "up" ? e.kind : "other";
      return `<div class="ev${e._new ? " new" : ""}"><time>${fmtTime(e.ts)}</time><div>
        <span class="k ${k}">${EV_LABEL[e.kind] || e.kind}</span><span class="n"${e.device_id && devIds.has(e.device_id) ? ` data-hist="${e.device_id}"` : ""}>${esc(e.device_id ? e.name : trMsg(e.name))}</span>
        ${e.host ? `<div class="d">${esc(e.host)}${e.detail ? " · " + esc(trMsg(e.detail)) : ""}</div>` : ""}</div></div>`;
    }).join("") || `<div class="ev"><span></span><div class="d">${t("Chưa có sự kiện")}</div></div>`;
    events.forEach(e => delete e._new);
  }

  let favState = null;
  function setFavicon(bad) {
    if (favState === bad) return; favState = bad;
    const c = bad ? "%23f85149" : "%232ea043";
    $("favicon").href = `data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Ccircle cx='8' cy='8' r='7' fill='${c}'/%3E%3C/svg%3E`;
  }

  // ------------------------------------------------------------ lay du lieu
  async function poll() {
    try {
      const since = lastEv === null ? -1 : lastEv;
      const r = await fetch("api/state?since=" + since, { cache: "no-store", credentials: "same-origin" });
      if (!r.ok) throw new Error(r.status);
      const j = await r.json();
      skew = j.now - Date.now() / 1000;
      lastOk = Date.now();
      if (lost) { lost = false; toast("info", t("Đã kết nối lại tới máy chủ giám sát")); }

      if (lastEv === null || j.last_event_id < lastEv) {
        events = j.events;
      } else if (j.events.length) {
        j.events.forEach(e => { e._new = true; if (e.device_id) delete histCache[e.device_id]; });
        if (histId && !H.hidden && j.events.some(e => e.device_id === histId)) showHist(histId, histRect);
        events = events.concat(j.events).slice(-300);
        const downs = j.events.filter(e => e.kind === "down"), ups = j.events.filter(e => e.kind === "up");
        downs.forEach(e => { flashUntil[e.device_id] = Date.now() + 8000; toast("down", t("Mất kết nối: ") + e.name, [e.host, trMsg(e.detail)].filter(Boolean).join(" · ")); });
        ups.forEach(e => { flashUntil[e.device_id] = Date.now() + 8000; toast("up", t("Đã kết nối lại: ") + e.name, e.host); });
        announce(downs, ups);
        if (downs.length) lastRemind = Date.now();
        if (downs.length && document.hidden && "Notification" in window && Notification.permission === "granted") {
          new Notification(t("Mất kết nối: ") + names(downs), { body: downs.map(e => e.host).join(", ") });
        }
      }
      lastEv = j.last_event_id;
      S = j;
      if (!document.querySelector(".modal:not([hidden])")) render();
      renderEvents();
    } catch (e) {
      checkLost();
    }
  }
  function checkLost() {
    const isLost = Date.now() - lastOk > LOST_MS;
    $("lostbar").hidden = !isLost;
    $("conn").className = "conn" + (isLost ? " lost" : "");
    $("conn").textContent = isLost ? t("Mất kết nối máy chủ") : t("Trực tuyến");
    if (isLost && !lost) {
      lost = true;
      toast("down", t("Mất kết nối tới máy chủ giám sát"), t("Kiểm tra mạng hoặc máy chủ giám sát"));
      if (!soundOff && snd.down) enqueue(async () => { await playWarn(); await speak(t("Mất kết nối tới máy chủ giám sát")); });
    }
  }
  function remind() {
    if (!snd.remind || soundOff || !S) return;
    const downs = S.devices.filter(d => d.status === "down");
    if (!downs.length) { lastRemind = Date.now(); return; }
    if (Date.now() - lastRemind >= snd.remind * 60000) {
      lastRemind = Date.now();
      announce(downs.map(d => ({ name: d.name })), []);
    }
  }

  // ------------------------------------------------------------ chon nhieu
  function setSelecting(on) {
    selecting = on;
    if (!on) picked.clear();
    $("btnSelect").classList.toggle("on", on);
    render();
  }
  function updSelbar() {
    $("selbar").hidden = !selecting;
    $("selCount").textContent = t("Đã chọn {0}", picked.size);
    document.querySelectorAll("#selbar [data-need]").forEach(b => b.disabled = !picked.size);
