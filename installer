  // ------------------------------------------------------------ cai dat am thanh
  function fillPresets(sel, lib, val) {
    sel.innerHTML = Object.entries(lib).map(([k, v]) => `<option value="${k}">${esc(t(v[0]))}</option>`).join("");
    sel.value = lib[val] ? val : Object.keys(lib)[0];
