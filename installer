  // ------------------------------------------------------------ hop thoai
  function open(id) { $(id).hidden = false; const f = $(id).querySelector("input:not([type=hidden]):not([type=checkbox]),textarea"); if (f) setTimeout(() => f.focus(), 30); }
  function close(el) { el.closest(".modal").hidden = true; render(); }
