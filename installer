    const t = F.type.value;
    F.querySelectorAll("[data-for]").forEach(el => el.hidden = !el.dataset.for.split(" ").includes(t));
    $("lHost").textContent = window.t(t === "dns" ? "Địa chỉ máy chủ DNS" : t === "http" ? "Địa chỉ IP / tên máy (tự lấy từ URL nếu để trống)" : "Địa chỉ IP / tên máy");
