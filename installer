  $("fConfirm").onsubmit = async e => {
    e.preventDefault();
    if (!$("cTypeWrap").hidden && !["XOA", "XÓA", "XOÁ", "DELETE"].includes(e.target.word.value.trim().toUpperCase())) { $("cErr").textContent = t("Gõ đúng chữ XOA để xác nhận"); return; }
